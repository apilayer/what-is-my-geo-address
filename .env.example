POSITIONSTACK_API_KEY=your_api_key_here

# Serve the app under a sub-path, e.g. /devtools/my-app. Leave EMPTY for local
# development so the app runs at the root. Next inlines this into the client
# bundle at build time, so it must be set for `npm run build`, not just at
# runtime, and changing it needs a rebuild.
NEXT_PUBLIC_BASE_PATH=

# Optional: serve public/ files (images, icons) from an absolute URL such as a
# CDN, instead of a basePath-relative path. Leave unset for default behavior.
NEXT_PUBLIC_ASSET_BASE_URL=

# --- Canonical URL -----------------------------------------------------------
# What crawlers are told about this page. Deliberately separate from
# NEXT_PUBLIC_BASE_PATH: where Next serves the app from and what its public
# address is are different questions, and conflating them either 404s local dev
# or points the canonical at a URL nobody can reach.
# Both are optional; unset falls back to the defaults in lib/site.ts.
NEXT_PUBLIC_SITE_ORIGIN=
NEXT_PUBLIC_SITE_PATH=
